{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "log_config": {
    // $env:PYTHONPATH = "F:\freqtrade" si module not found
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
      "paris_time": {
        "()": "user_data.paris_formatter.ParisTimeFormatter",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
      }
    },
    "handlers": {
      "file": {
        "class": "logging.handlers.RotatingFileHandler",
        "formatter": "paris_time",
        "filename": "user_data/logs/freqtrade.log",
        "maxBytes": 10485760,
        "backupCount": 10,
        "encoding": "utf-8"
      },
      "console": {
        "class": "logging.StreamHandler",
        "formatter": "paris_time",
        "stream": "ext://sys.stdout"
      }
    },
    "root": {
      "level": "INFO",
      "handlers": ["file", "console"]
    }
  },
  "max_open_trades": 20,
  "stake_currency": "USD",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.8,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 2500,
  "strategy": "Str001",
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "margin_mode": "",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "download_trades": true,
  "exchange": {
    "name": "kraken",
    "api_key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [],
    "pair_blacklist": [
      "AUD/USD",
      "EUR/USD",
      "EUROP/USD",
      "EURC/USD",
      "GBP/USD",
      "POL/USD",
      "USDC/USD",
      "USDG/USD",
      "USDT/USD"
    ]
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 100,
      "sort_key": "quoteVolume",
      "min_value": 0,
      "refresh_period": 1800
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "a91d144601e8a07001643161ee85a9c7f55a491f166a0e278c4049115a7526c3",
